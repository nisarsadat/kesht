# Copy this file to .env.local and fill in values from the Neon console.
#
# Client (baked into the Vite build):
# 1. Open your project -> Data API -> copy the REST API URL.
#
# Server (used by /api/auth on Vercel; required for Safari/iPhone login):
# 2. Open your project -> Auth -> copy the Auth base URL into NEON_AUTH_BASE_URL.
# 3. Generate NEON_AUTH_COOKIE_SECRET (at least 32 characters), e.g.:
#    openssl rand -base64 32
#
# VITE_NEON_DATA_API_URL is a public endpoint and safe to expose in a browser build.
# The Data API is protected by row level security and the signed-in user's JWT.
# Do not expose NEON_AUTH_COOKIE_SECRET in VITE_* variables.

VITE_NEON_DATA_API_URL=https://your-project.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

NEON_AUTH_BASE_URL=https://your-project.neonauth.us-east-2.aws.neon.build/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-secret-at-least-32-characters-long
