# Copy this file to .env.local and fill in the two values from the Neon console.
#
# 1. Open your project -> Data API -> copy the REST API URL.
# 2. Open your project -> Auth -> copy the Auth base URL.
#
# Both are public endpoints and safe to expose in a browser build. The Data API
# is protected by row level security and the signed-in user's JWT.

VITE_NEON_AUTH_URL=https://your-project.neonauth.us-east-2.aws.neon.build/neondb/auth
VITE_NEON_DATA_API_URL=https://your-project.apirest.us-east-2.aws.neon.tech/neondb/rest/v1
