# Copy this file to .env.local and fill in the two values from
# Supabase -> Project Settings -> API.
#
# Both are safe to expose in a browser build. The anon key only grants what row
# level security allows, which is why 0001_init.sql must be applied first.
# NEVER put the service_role key here — it bypasses every access rule.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
